diff --git a/librecomp/src/nx_memory.cpp b/librecomp/src/nx_memory.cpp
new file mode 100644
index 0000000..c631a0e
--- /dev/null
+++ b/librecomp/src/nx_memory.cpp
@@ -0,0 +1,85 @@
+#ifdef __SWITCH__
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+#include <switch.h>
+
+#include "librecomp/nx_memory.hpp"
+
+namespace {
+    struct Mapping {
+        void* address;
+        void* backing;
+        Handle handle;
+        size_t size;
+    };
+
+    std::mutex mutex;
+    VirtmemReservation* reservation = nullptr;
+    std::vector<Mapping> mappings;
+}
+
+uint8_t* recomp::nx::reserve(size_t size) {
+    std::lock_guard lock{ mutex };
+    virtmemLock();
+    void* address = virtmemFindAslr(size, 0x10000);
+    if (address != nullptr) {
+        reservation = virtmemAddReservation(address, size);
+    }
+    virtmemUnlock();
+    if (reservation == nullptr) {
+        std::fprintf(stderr, "[nx_memory] could not reserve 0x%zX bytes\n", size);
+        return nullptr;
+    }
+    std::fprintf(stderr, "[nx_memory] reserved 0x%zX bytes at %p\n", size, address);
+    return static_cast<uint8_t*>(address);
+}
+
+bool recomp::nx::commit(void* address, size_t size) {
+    std::lock_guard lock{ mutex };
+    // The backing memory comes from the heap; once it's code memory, only its mapping is used.
+    void* backing = std::aligned_alloc(0x1000, size);
+    if (backing == nullptr) {
+        std::fprintf(stderr, "[nx_memory] out of memory for 0x%zX bytes\n", size);
+        return false;
+    }
+    std::memset(backing, 0, size);
+    Handle handle;
+    Result rc = svcCreateCodeMemory(&handle, backing, size);
+    if (R_SUCCEEDED(rc)) {
+        rc = svcControlCodeMemory(handle, CodeMapOperation_MapOwner, address, size, Perm_Rw);
+        if (R_FAILED(rc)) {
+            svcCloseHandle(handle);
+        }
+    }
+    if (R_FAILED(rc)) {
+        std::fprintf(stderr, "[nx_memory] could not map 0x%zX bytes at %p: 0x%X\n", size, address, rc);
+        std::free(backing);
+        return false;
+    }
+    mappings.push_back({ address, backing, handle, size });
+    std::fprintf(stderr, "[nx_memory] mapped 0x%zX bytes at %p\n", size, address);
+    return true;
+}
+
+void recomp::nx::release() {
+    std::lock_guard lock{ mutex };
+    for (const Mapping& mapping : mappings) {
+        svcControlCodeMemory(mapping.handle, CodeMapOperation_UnmapOwner, mapping.address, mapping.size, Perm_None);
+        svcCloseHandle(mapping.handle);
+        std::free(mapping.backing);
+    }
+    mappings.clear();
+    if (reservation != nullptr) {
+        virtmemLock();
+        virtmemRemoveReservation(reservation);
+        virtmemUnlock();
+        reservation = nullptr;
+    }
+}
+
+#endif
