new file mode 100644
index 0000000..62efe65
--- /dev/null
+++ b/librecomp/include/librecomp/nx_memory.hpp
@@ -0,0 +1,24 @@
+#ifndef __RECOMP_NX_MEMORY_HPP__
+#define __RECOMP_NX_MEMORY_HPP__
+
+// Nintendo Switch (Horizon) game memory. Horizon has no mmap or mprotect: the 4GB range the recompiled
+// code addresses is reserved in the address space (libnx virtmem), and the parts that are used (RDRAM,
+// and the game's TLB-mapped pages) are backed by heap memory mapped there as code memory, which may be
+// mapped at any address the reservation holds.
+
+#include <cstddef>
+#include <cstdint>
+
+namespace recomp {
+    namespace nx {
+        // Reserves `size` bytes of address space, with nothing mapped. Returns its start, or nullptr.
+        uint8_t* reserve(size_t size);
+        // Maps zeroed read/write memory at [address, address + size), inside the reservation.
+        // Both must be multiples of 0x1000.
+        bool commit(void* address, size_t size);
+        // Unmaps everything and frees the reservation.
+        void release();
+    }
+}
+
+#endif
