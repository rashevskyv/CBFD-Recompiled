+#elif defined(__SWITCH__)
+#include <atomic>
+#include <switch.h>
+
+void ultramodern::set_native_thread_name(const std::string& name) {
+    // Horizon threads have no settable name.
+    (void)name;
+}
+
+void ultramodern::set_native_thread_priority(ThreadPriority pri) {
+    // Horizon: a lower number runs first; applications get 0x1C-0x3B, the main thread 0x2C.
+    s32 priority = 0x2C;
+    switch (pri) {
+        case ThreadPriority::Low:      priority = 0x2E; break;
+        case ThreadPriority::Normal:   priority = 0x2C; break;
+        case ThreadPriority::High:     priority = 0x2B; break;
+        case ThreadPriority::VeryHigh: priority = 0x2A; break;
+        case ThreadPriority::Critical: priority = 0x29; break;
+        default: break;
+    }
+    svcSetThreadPriority(CUR_THREAD_HANDLE, priority);
+    // New threads all start on core 0: deal them out over cores 0-2 (core 3 is the system's,
+    // and does not time-slice).
+    static std::atomic<int> next_core{ 0 };
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, next_core++ % 3, 0x7);
+}
 #endif
 
 static PTR(PTR(OSThread)) running_thread_variable = NULLPTR;
