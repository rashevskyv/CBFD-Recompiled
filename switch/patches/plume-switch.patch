+    void VulkanDevice::pipelineCreated() {
+#   ifdef PLUME_VULKAN_PIPELINE_CACHE_FILE
+        // Saved as pipelines are made, not only on exit, which a console's HOME menu may skip.
+        // At most every 10 seconds: a save writes the whole cache.
+        std::lock_guard lock(pipelineCacheMutex);
+        pipelinesSinceSave++;
+        if (std::chrono::steady_clock::now() - pipelineCacheSaveTime >= std::chrono::seconds(10)) {
+            savePipelineCache();
+        }
+#   endif
+    }
+
+    void VulkanDevice::loadPipelineCache() {
+#   ifdef PLUME_VULKAN_PIPELINE_CACHE_FILE
+        // The driver checks the data's header (vendor, device, cache UUID) and ignores another build's.
+        std::vector<uint8_t> data;
+        FILE *file = fopen(PLUME_VULKAN_PIPELINE_CACHE_FILE, "rb");
+        if (file != nullptr) {
+            fseek(file, 0, SEEK_END);
+            long size = ftell(file);
+            fseek(file, 0, SEEK_SET);
+            if (size > 0) {
+                data.resize(size_t(size));
+                if (fread(data.data(), 1, data.size(), file) != data.size()) {
+                    data.clear();
+                }
+            }
+
+            fclose(file);
+        }
+
+        VkPipelineCacheCreateInfo cacheInfo = {};
+        cacheInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+        cacheInfo.initialDataSize = data.size();
+        cacheInfo.pInitialData = data.empty() ? nullptr : data.data();
+        VkResult res = vkCreatePipelineCache(vk, &cacheInfo, nullptr, &pipelineCache);
+        if ((res != VK_SUCCESS) && !data.empty()) {
+            // Unusable data: start empty.
+            cacheInfo.initialDataSize = 0;
+            cacheInfo.pInitialData = nullptr;
+            res = vkCreatePipelineCache(vk, &cacheInfo, nullptr, &pipelineCache);
+        }
+
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreatePipelineCache failed with error code 0x%X.\n", res);
+            pipelineCache = VK_NULL_HANDLE;
+            return;
+        }
+
+        fprintf(stderr, "Pipeline cache: %zu bytes read from %s.\n", data.size(), PLUME_VULKAN_PIPELINE_CACHE_FILE);
+        pipelineCacheSaveTime = std::chrono::steady_clock::now();
+#   endif
+    }
+
+    void VulkanDevice::savePipelineCache() {
+#   ifdef PLUME_VULKAN_PIPELINE_CACHE_FILE
+        // Called with pipelineCacheMutex held.
+        if ((pipelineCache == VK_NULL_HANDLE) || (pipelinesSinceSave == 0)) {
+            return;
+        }
+
+        size_t size = 0;
+        if (vkGetPipelineCacheData(vk, pipelineCache, &size, nullptr) != VK_SUCCESS) {
+            return;
+        }
+
+        std::vector<uint8_t> data(size);
+        if (vkGetPipelineCacheData(vk, pipelineCache, &size, data.data()) != VK_SUCCESS) {
+            return;
+        }
+
+        // Written beside, then renamed over the old one, so a crash mid-write keeps the last good cache.
+        const std::string path = PLUME_VULKAN_PIPELINE_CACHE_FILE;
+        const std::string temporaryPath = path + ".new";
+        FILE *file = fopen(temporaryPath.c_str(), "wb");
+        if (file == nullptr) {
+            return;
+        }
+
+        bool written = (fwrite(data.data(), 1, size, file) == size);
+        written = (fclose(file) == 0) && written;
+        if (written) {
+            remove(path.c_str());
+            written = (rename(temporaryPath.c_str(), path.c_str()) == 0);
+        }
+
+        if (written) {
+            pipelinesSinceSave = 0;
+        }
+
+        pipelineCacheSaveTime = std::chrono::steady_clock::now();
+#   endif
+    }
+
     void VulkanDevice::release() {
         nullBuffer = nullptr; // force destruction before destroying allocator
 
+        if (pipelineCache != VK_NULL_HANDLE) {
