diff --git a/recompui/src/composites/ui_mod_installer.cpp b/recompui/src/composites/ui_mod_installer.cpp
index c91df6f..b580186 100644
--- a/recompui/src/composites/ui_mod_installer.cpp
+++ b/recompui/src/composites/ui_mod_installer.cpp
@@ -4,6 +4,7 @@
 #include "recompui/recompui.h"
 
 #include <algorithm>
+#include <fstream>
 
 namespace recompui {
     static const std::string ManifestFilename = "mod.json";
@@ -18,6 +19,10 @@ namespace recompui {
         return file_path.extension() == ".so" || file_path.filename().string().find(".so.") != std::string::npos;
 #elif defined(__APPLE__)
         return file_path.extension() == ".dylib";
+#elif defined(__SWITCH__)
+        // No dynamic libraries on the Switch.
+        (void)file_path;
+        return false;
 #else
         static_assert(false, "Unimplemented for this platform.");
 #endif
@@ -40,7 +45,18 @@ namespace recompui {
         std::filesystem::path target_path = recomp::mods::get_mods_directory() / file_path.filename();
         std::filesystem::path target_write_path = target_path.u8string() + NewExtension;
         std::error_code ec;
+#if defined(__SWITCH__)
+        // copy_file fails on the Switch's SD card (it sets the copy's permissions): copy the bytes.
+        {
+            std::ifstream in(file_path, std::ios::binary);
+            std::ofstream out(target_write_path, std::ios::binary | std::ios::trunc);
+            if (!in || !out || !(out << in.rdbuf()) || !out.flush()) {
+                ec = std::make_error_code(std::errc::io_error);
+            }
+        }
+#else
         std::filesystem::copy_file(file_path, target_write_path, std::filesystem::copy_options::overwrite_existing, ec);
+#endif
         if (ec) {
             result.error_messages.emplace_back("Unable to install " + file_path.filename().string() + " to mod directory.");
             std::filesystem::remove(target_write_path, ec);
diff --git a/recompui/src/composites/ui_mod_menu.cpp b/recompui/src/composites/ui_mod_menu.cpp
