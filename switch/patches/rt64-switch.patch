diff --git a/src/common/rt64_thread.cpp b/src/common/rt64_thread.cpp
index c4b080b..9e1a3ba 100644
--- a/src/common/rt64_thread.cpp
+++ b/src/common/rt64_thread.cpp
@@ -12,6 +12,9 @@
 #   include "utf8conv/utf8conv.h"
 #elif defined(__linux__)
 #   include <pthread.h>
+#elif defined(__SWITCH__)
+#   include <atomic>
+#   include <switch.h>
 #endif
 
 namespace RT64 {
@@ -47,6 +50,9 @@ namespace RT64 {
         pthread_setname_np(pthread_self(), str.c_str());
 #   elif defined(__APPLE__)
         pthread_setname_np(str.c_str());
+#   elif defined(__SWITCH__)
+        // Horizon threads have no settable name.
+        (void)str;
 #   else
         static_assert(false, "Unimplemented");
 #   endif
@@ -61,6 +67,35 @@ namespace RT64 {
         // from -20 to 19 (lower being higher priority). However, by strict POSIX spec "nice" is meant to be per-process instead of
         // per-thread. Therefore to avoid issues in case Linux is modified to match the spec in the future, this function does nothing.
         (void)priority;
+#   elif defined(__SWITCH__)
+        // Horizon: a lower number runs first; applications get 0x1C-0x3B, the main thread 0x2C.
+        s32 nxPriority = 0x2C;
+        switch (priority) {
+        case Thread::Priority::Idle:
+            nxPriority = 0x3B;
+            break;
+        case Thread::Priority::Lowest:
+            nxPriority = 0x30;
+            break;
+        case Thread::Priority::Low:
+            nxPriority = 0x2E;
+            break;
+        case Thread::Priority::Normal:
+            nxPriority = 0x2C;
+            break;
+        case Thread::Priority::High:
+            nxPriority = 0x2B;
+            break;
+        case Thread::Priority::Highest:
+            nxPriority = 0x2A;
+            break;
+        default:
+            break;
+        }
+        svcSetThreadPriority(CUR_THREAD_HANDLE, nxPriority);
+        // New threads all start on core 0: deal them out over cores 0-2 (core 3 is the system's).
+        static std::atomic<int> nextCore{ 1 };
+        svcSetThreadCoreMask(CUR_THREAD_HANDLE, nextCore++ % 3, 0x7);
 #   else
         static_assert(false, "Unimplemented");
 #   endif
