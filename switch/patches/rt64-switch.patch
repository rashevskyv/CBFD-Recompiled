@@ -33,6 +33,8 @@ namespace RT64 {
         if (fileHandle != nullptr) {
             CloseHandle(fileHandle);
         }
+#   elif defined(__SWITCH__)
+        // fileData frees itself.
 #   else
         if (fileView != MAP_FAILED) {
             munmap(fileView, fileSize);
@@ -79,6 +81,26 @@ namespace RT64 {
             return false;
         }
 
+        return true;
+#   elif defined(__SWITCH__)
+        FILE *file = fopen(path.c_str(), "rb");
+        if (file == nullptr) {
+            fprintf(stderr, "fopen for %s failed with error %s.\n", path.c_str(), strerror(errno));
+            return false;
+        }
+
+        fseek(file, 0, SEEK_END);
+        long size = ftell(file);
+        fseek(file, 0, SEEK_SET);
+        fileData.resize(size > 0 ? size_t(size) : 0);
+        fileRead = (size >= 0) && (fread(fileData.data(), 1, fileData.size(), file) == fileData.size());
+        fclose(file);
+        if (!fileRead) {
+            fprintf(stderr, "fread for %s failed.\n", path.c_str());
+            fileData.clear();
+            return false;
+        }
+
         return true;
 #   else
         fileHandle = ::open(path.c_str(), O_RDONLY);
